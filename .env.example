# ============================================================
# Assessment OPM - Environment Configuration
# ============================================================

# Database Configuration (PostgreSQL)
POSTGRES_USER=opm_user
POSTGRES_PASSWORD=opm_password
POSTGRES_DB=opm_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database Connection URLs
# Asyncpg driver used by FastAPI for non-blocking asynchronous queries
DATABASE_URL=postgresql+asyncpg://opm_user:opm_password@localhost:5432/opm_db
# Sync/psycopg driver used by Celery worker and Alembic migrations
SYNC_DATABASE_URL=postgresql+psycopg://opm_user:opm_password@localhost:5432/opm_db

# Redis & Celery Configuration
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Backend Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# File Storage
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=250

# Webhook Engine
WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_MAX_RETRIES=3
WEBHOOK_BACKOFF_FACTOR=2

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
PORT=3000
